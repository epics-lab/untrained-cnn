# Copy to paths.env (gitignored) and fill in for your machine/cluster.
# `slurm/env.example.sh` exports these same variables for SLURM jobs; keep
# both in sync if you change one. For interactive/non-SLURM use:
#   set -a; source config/paths.env; set +a

# NKI Rockland Sample data (external -- has its own data-use agreement, not
# included in this repo). Subject/Sex/Age demographics file, turboprep-
# normalized T1w roots (RIGID = original rigid registration, kept for
# provenance/rollback but currently unused by any script; AFFINE = the
# affine-registered version everything now actually reads from), and the
# raw NKI_BIDS tree (for CAT12 mwp1 VBM maps).
NKI_DEMOGRAPHICS=/path/to/NKI/final_demographics.txt
NKI_RIGID_TURBOPREP_ROOT=/path/to/turboprep_NKI
NKI_AFFINE_TURBOPREP_ROOT=/path/to/NKI_hdbet_affine
NKI_BIDS_ROOT=/path/to/NKI_BIDS

# Only needed for --target bmi: participants.tsv is a separate, longitudinal
# phenotype file (has a header, multiple rows per subject/session) that BMI
# is joined in from -- NKI_DEMOGRAPHICS itself has no BMI column. See
# src/targets.py's load_bmi_lookup for the exact join (filters to the BAS1
# baseline visit).
NKI_PARTICIPANTS_TSV=/path/to/NKI/participants.tsv

# PPMI reference-baseline cohort (see src/build_dataset_demographics.py and
# src/build_freesurfer_roi_tables.py, both --dataset ppmi).
PPMI_TURBOPREP_ROOT=/path/to/PPMI_hdbet_affine
PPMI_SUBJECTS_LIST=/path/to/PPMI_hdbet_affine/common_subjects.txt
PPMI_COHORT_CSV=/path/to/PPMI_raw/processed_cohort_with_mri.csv
PPMI_FREESURFER_CTH_CSV=/path/to/FS7_APARC_CTH_23Oct2025.csv
PPMI_FREESURFER_SA_CSV=/path/to/FS7_APARC_SA_23Oct2025.csv
PPMI_CAT12_BIDS_ROOT=/path/to/ppmi_cat12_bids
PPMI_DEMOGRAPHICS=/path/to/repo/artifacts/demographics/ppmi_baseline_demographics.tsv

# HBN reference-baseline cohort (see src/build_dataset_demographics.py and
# src/build_freesurfer_roi_tables.py, both --dataset hbn). CAT12 output is
# split across two non-overlapping BIDS trees -- build_freesurfer_roi_tables.py
# --build-cat12-merged-root merges them into one symlink tree since
# cat12_paths_and_subjects (train_linear.py) only takes a single root.
HBN_TURBOPREP_ROOT=/path/to/HBN_hdbet_affine
HBN_SUBJECTS_LIST=/path/to/HBN_raw/final_subjects.txt
HBN_DEMOGRAPHICS_RAW=/path/to/HBN_raw/final_preprocessed_subjects_with_demographics.tsv
HBN_PARTICIPANTS_TSV=/path/to/HBN_raw/study-HBN_desc-participants.tsv
HBN_FREESURFER_ROOT=/path/to/HBN_FreeSurfer/freesurfer
HBN_CAT12_BIDS_ROOT_1=/path/to/HBN_BIDS
HBN_CAT12_BIDS_ROOT_2=/path/to/hbn_bids
HBN_DEMOGRAPHICS=/path/to/repo/artifacts/demographics/hbn_baseline_demographics.tsv

# Pretrained 3D backbone checkpoints (external -- BrainIAC.ckpt is under
# BrainIAC's research-only license; Brain_Swin_UNETR.pth and
# simclr_3d_brain_foundation.tar are the SwinBrain/SimCLR checkpoints. All
# three are expected directly in this one directory).
BACKBONE_CHECKPOINT_DIR=/path/to/BrainIAC/checkpoints

# AnatCL (external, MIT-licensed, own repo: https://github.com/EIDOSLAB/AnatCL).
# Clone it and point this at the checkout; weights_{global,local}_fold{0-4}.pth
# are expected under BACKBONE_CHECKPOINT_DIR (or pass --anatcl-ckpt-dir).
ANATCL_REPO_ROOT=/path/to/AnatCL

# TemplateFlow's MNI152NLin2009cAsym (res-01), used to overlay saliency maps
# at a common anatomical grid. Fetch via `pip install templateflow` and
# TemplateFlowAPI().get("MNI152NLin2009cAsym", resolution=1, ...), or point
# this at an existing local cache.
TEMPLATEFLOW_MNI_DIR=/path/to/templateflow/tpl-MNI152NLin2009cAsym
