# Copy to paths.env and fill in. Lines may also be sourced in bash.

# Checkpoints
ANATCL_WEIGHTS_DIR=/path/to/anatcl_weights            # weights_{global,local}_fold{0..4}.pth
BRAINIAC_CKPT=/path/to/BrainIAC.ckpt
SWINBRAIN_CKPT=/path/to/Brain_Swin_UNETR.pth
SIMCLR_CKPT=/path/to/simclr_3d_brain_foundation.tar

# PPMI
PPMI_LABELS=/path/to/PPMI/labels.csv                  # PATNO, Sex (M or F), Age
PPMI_SUBJECT_LIST=/path/to/PPMI/subjects.txt          # optional, one PATNO per line
PPMI_AFFINE_DIR=/path/to/PPMI/affine                  # <PATNO>/normalized.nii.gz
PPMI_CAT12_DIR=/path/to/PPMI/cat12                    # searched recursively for .../sub-<PATNO>/.../mwp1*.nii*
PPMI_FS_CTH=/path/to/PPMI/FS7_APARC_CTH.csv           # PATNO, EVENT_ID, one column per measure
PPMI_FS_SA=/path/to/PPMI/FS7_APARC_SA.csv

# NKI, Reproducible Brain Charts
NKI_DEMOGRAPHICS=/path/to/NKI/demographics.txt        # tab separated, no header: ID, Female or Male, age
NKI_PARTICIPANTS=/path/to/NKI/participants.tsv        # participant_id, wave, bmi
NKI_SUBJECT_LIST=/path/to/NKI/subjects.txt            # optional, one ID per line
NKI_AFFINE_DIR=/path/to/NKI/affine                    # <ID>/normalized.nii.gz
NKI_BIDS_DIR=/path/to/NKI/bids                        # sub-<ID>/ses-BAS1/anat/mri/mwp1*.nii
NKI_FREESURFER_DIR=/path/to/NKI/freesurfer            # sub-<ID>_ses-BAS1/sub-<ID>_ses-BAS1_regionsurfacestats.tsv
NKI_RIGID_DIR=/path/to/NKI/rigid                      # architecture ablation: <ID>/normalized.nii.gz, TurboPrep with -r r

# HBN, Reproducible Brain Charts
HBN_DEMOGRAPHICS=/path/to/HBN/demographics.tsv        # participant_id, sex (Male or Female), age
HBN_PARTICIPANTS=/path/to/HBN/study-HBN_desc-participants.tsv   # participant_id, bmi
HBN_SUBJECT_LIST=/path/to/HBN/subjects.txt            # optional, one ID per line
HBN_AFFINE_DIR=/path/to/HBN/affine                    # <ID>/normalized.nii.gz
HBN_CAT12_DIRS=/path/to/HBN/bids                      # colon separated, searched in order: sub-<ID>/ses-*/anat/mri/mwp1sub*.nii
HBN_FREESURFER_DIR=/path/to/HBN/freesurfer            # sub-<ID>/sub-<ID>_regionsurfacestats.tsv

# Optional, defaults to experiments/outputs
# OUTPUT_DIR=/path/to/outputs
